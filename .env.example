# ==============================================================================
# SIH26051 Shelter Studio — Environment Variables Template
# Copy this file to .env and replace placeholders with your actual credentials.
# Refer to docs/keys_and_secrets_guide.md for instructions on obtaining keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Required for cloud persistence, weather cache, & NLP feedback)
# With no Supabase keys set, the application automatically falls back to local SQLite.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY

# ------------------------------------------------------------------------------
# Database Tuning (Optional)
# ------------------------------------------------------------------------------
SUPABASE_WRITE_BATCH=5000
SUPABASE_PAGE_SIZE=10000

# ------------------------------------------------------------------------------
# Local Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=8200
DOTENV_DISABLED=0

# ------------------------------------------------------------------------------
# Vercel Deployment Identifiers (Used by Vercel CLI & API deployment tools)
# ------------------------------------------------------------------------------
# VERCEL_TOKEN=YOUR_VERCEL_PERSONAL_ACCESS_TOKEN
# VERCEL_PROJECT_ID=prj_Gdmqv53W9c1a790LInFHzo6VnQd5
# VERCEL_TEAM_ID=team_d3G4qjveijN92tnzWfMmNdb6

# ------------------------------------------------------------------------------
# GitHub Automation / CI/CD (Used for pushing updates and running actions)
# ------------------------------------------------------------------------------
# GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
