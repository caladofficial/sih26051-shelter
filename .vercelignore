# Heavy / regenerable files that must NOT be uploaded to Vercel
.venv
.git
.gitignore
.env
.env.*
!.env.example

# local runtime data (regenerated by scripts or stored in Supabase)
data/raw
data/processed
# ~26 MB of hourly CSVs: the serverless API reads hourly weather from
# Supabase, and the derived summaries ship as public/data/climate_bundle.json.
# data/climate/index.json IS uploaded (small) — /api/climate/coverage needs it.
data/climate/hourly
data/climate/refresh_log.json
data/external/*.epw
data/external/*.json

# local-only tooling & results
results
simulation
notebooks
tests
app
scripts
assets

# misc
*.log
__pycache__
.pytest_cache
.vercel
pyproject.toml
uv.lock
.python-version

# readable frontend sources — only the obfuscated build in public/ is deployed
public-src
# internal design/API/deployment docs — never served to visitors
docs
ml/data
